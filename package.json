{
  "name": "typesherlock",
  "version": "0.1.0",
  "description": "Pipe a JSON API response in, get a TypeScript interface + Zod schema out. Deduces types instead of guessing them.",
  "type": "module",
  "bin": {
    "typesherlock": "./dist/cli.js",
    "typesherlock-mcp": "./dist/mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run lint && npm run format:check && npm run build && npm test"
  },
  "keywords": [
    "typescript",
    "json",
    "type-inference",
    "zod",
    "cli",
    "codegen",
    "api"
  ],
  "license": "MIT",
  "author": "tirdesh <tirdesh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tirdesh/typesherlock.git"
  },
  "bugs": {
    "url": "https://github.com/tirdesh/typesherlock/issues"
  },
  "homepage": "https://github.com/tirdesh/typesherlock#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.15",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}
